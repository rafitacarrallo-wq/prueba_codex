generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
  ARCHIVED
}

enum ApplicationSource {
  LINKEDIN
  INDEED
  REFERRAL
  COMPANY_SITE
  OTHER
}

model Application {
  id                 String             @id @default(uuid())
  companyName        String
  companyDomain      String?
  logoUrl            String?
  roleTitle          String
  appliedAt          DateTime?
  status             ApplicationStatus  @default(SAVED)
  jobUrl             String?
  salaryMin          Int?
  salaryMax          Int?
  salaryExpectation  Int?
  interestLevel      Int?               @db.SmallInt
  source             ApplicationSource? 
  notes              String?
  nextStep           String?
  nextStepDate       DateTime?
  cvVersion          String?
  coverLetterVersion String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  contacts           ApplicationContact[]

  @@index([status])
  @@index([companyName])
}

model Contact {
  id          String                @id @default(uuid())
  fullName    String
  companyName String?
  title       String?
  linkedinUrl String?
  email       String?
  phone       String?
  notes       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  interactions   Interaction[]
  reminders      FollowUpReminder[]
  applications   ApplicationContact[]

  @@index([fullName])
}

model Interaction {
  id        String   @id @default(uuid())
  contact   Contact  @relation(fields: [contactId], references: [id])
  contactId String
  note      String
  date      DateTime @default(now())
}

model FollowUpReminder {
  id        String   @id @default(uuid())
  contact   Contact  @relation(fields: [contactId], references: [id])
  contactId String
  date      DateTime
  note      String?
  done      Boolean  @default(false)
}

model WatchlistCompany {
  id         String   @id @default(uuid())
  name       String
  domain     String?
  logoUrl    String?
  notes      String?
  careersUrl String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([name])
}

model ApplicationContact {
  application   Application @relation(fields: [applicationId], references: [id])
  applicationId String
  contact       Contact     @relation(fields: [contactId], references: [id])
  contactId     String

  @@id([applicationId, contactId])
}
